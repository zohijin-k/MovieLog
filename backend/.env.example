# 이 파일을 .env로 복사한 뒤 JWT_SECRET을 새 난수로 교체하세요. 실제 .env는 제출하지 않습니다.
# 키 생성: python -c "import secrets; print(secrets.token_hex(32))"
# 아래 예시 값 그대로 서버를 시작하면 의도적으로 실행이 거부됩니다(사용 금지).
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
JWT_ISSUER=webservice-class
JWT_AUDIENCE=board-api
# 토큰 유효 시간(초). 만료 테스트는 3으로 바꾸고 서버를 재시작하세요.
TOKEN_TTL=90
DB_FILE=data/board.sqlite
PORT=8000
